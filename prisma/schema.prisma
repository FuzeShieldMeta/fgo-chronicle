// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
  // Further reading:
  // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
  // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
  url      = env("DATABASE_URL")
}

// Necessary for Next auth
model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? // @db.Text
  access_token             String? // @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? // @db.Text
  session_state            String?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  refresh_token_expires_in Int?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  emailVerified DateTime?
  image         String?
  isCurator     Boolean       @default(false)
  accounts      Account[]
  sessions      Session[]
  plannerState  PlannerState?
}

model PlannerState {
  userId    String   @id
  payload   Json
  revision  Int      @default(1)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ScheduleStatus {
  PROJECTED
  CURATED
  OFFICIAL
}

enum ScheduleTimePrecision {
  DATE_ONLY
  EXACT
}

enum EventType {
  MAIN_EVENT
  PRE_RELEASE_CAMPAIGN
  LOGIN_BONUS
  CAMPAIGN
  EVENT_SHOP
  QUEST_RELEASE
  LIMITED_MISSION
  MAINTENANCE
  OTHER
}

enum RewardSourceType {
  LOGIN_BONUS
  PRE_CAMPAIGN
  EVENT_SHOP
  MANA_PRISM_EXCHANGE
  POINT_REWARD
  LOTTERY
  QUEST_CLEAR
  CHALLENGE_QUEST
  LIMITED_MISSION
  MASTER_MISSION
  SOCIAL_CAMPAIGN
  MAINTENANCE
  LOGIN_MILESTONE
  OTHER
}

enum RewardItemType {
  SAINT_QUARTZ
  SAINT_QUARTZ_FRAGMENT
  SUMMON_TICKET
  CRYSTALLIZED_LORE
  HOLY_GRAIL
}

enum RewardNature {
  DETERMINISTIC
  CONDITIONAL
  CURATED_ESTIMATE
}

enum ScheduleProjectionMethod {
  TWO_CALENDAR_YEARS
}

enum SyncRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model EventFamily {
  id                String               @id @default(cuid())
  sourceKey         String               @unique
  name              String
  artworkUrl        String?
  artworkSourceUrl  String?
  artworkAlt        String?
  artworkReviewedAt DateTime?
  events            Event[]
  banners           Banner[]
  curation          EventFamilyCuration?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model Event {
  id                String                    @id @default(cuid())
  sourceKey         String                    @unique
  familyId          String?
  name              String
  type              EventType
  startsAt          DateTime
  startsAtPrecision ScheduleTimePrecision     @default(EXACT)
  endsAt            DateTime?
  endsAtPrecision   ScheduleTimePrecision?
  status            ScheduleStatus
  sourceUrl         String?
  sourceRegion      String
  sourceStartsAt    DateTime?
  sourceEndsAt      DateTime?
  projectionMethod  ScheduleProjectionMethod?
  lastSyncedAt      DateTime?
  sourceContentHash String?
  family            EventFamily?              @relation(fields: [familyId], references: [id], onDelete: SetNull)
  rewardSources     RewardSource[]
  curation          EventCuration?
  reviews           EventReview[]
  dateEvidence      EventDateEvidence[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([startsAt])
  @@index([status, startsAt])
  @@index([familyId, startsAt])
}

model RewardSource {
  id             String             @id @default(cuid())
  sourceKey      String             @unique
  eventId        String?
  name           String
  type           RewardSourceType
  status         ScheduleStatus
  evidenceUrl    String
  lastVerifiedAt DateTime?
  event          Event?             @relation(fields: [eventId], references: [id], onDelete: SetNull)
  rewards        RewardDefinition[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([eventId])
  @@index([type, status])
}

model RewardDefinition {
  id              String          @id @default(cuid())
  sourceKey       String          @unique
  rewardSourceId  String
  itemType        RewardItemType
  amount          Int
  expectedAt      DateTime?
  nature          RewardNature
  eligibility     String?
  storyWarId      Int?
  storyReleaseAt  DateTime?
  defaultIncluded Boolean         @default(true)
  reviewedAt      DateTime?
  rewardSource    RewardSource    @relation(fields: [rewardSourceId], references: [id], onDelete: Cascade)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  curation        RewardCuration?
  reviews         RewardReview[]

  @@index([rewardSourceId, expectedAt])
  @@index([itemType, expectedAt])
}

model EventFamilyCuration {
  familyId  String      @id
  active    Boolean     @default(true)
  revision  Int         @default(1)
  name      String
  updatedAt DateTime    @updatedAt
  family    EventFamily @relation(fields: [familyId], references: [id], onDelete: Restrict)
}

model EventCuration {
  eventId           String                 @id
  active            Boolean                @default(true)
  revision          Int                    @default(1)
  ownedFields       String[]               @default(["name", "startsAt", "endsAt", "hidden", "shiftRewardDates"])
  name              String
  startsAt          DateTime
  startsAtPrecision ScheduleTimePrecision
  endsAt            DateTime?
  endsAtPrecision   ScheduleTimePrecision?
  hidden            Boolean                @default(false)
  shiftRewardDates  Boolean                @default(true)
  updatedAt         DateTime               @updatedAt
  event             Event                  @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([active, startsAt])
}

model RewardCuration {
  rewardId        String           @id
  active          Boolean          @default(true)
  revision        Int              @default(1)
  ownedFields     String[]         @default(["itemType", "amount", "expectedAt", "nature", "eligibility", "defaultIncluded"])
  itemType        RewardItemType
  amount          Int
  expectedAt      DateTime?
  nature          RewardNature
  eligibility     String?
  defaultIncluded Boolean
  updatedAt       DateTime         @updatedAt
  reward          RewardDefinition @relation(fields: [rewardId], references: [id], onDelete: Restrict)

  @@index([active, expectedAt])
}

model EventReview {
  id            String   @id @default(cuid())
  eventId       String
  actorId       String
  sourceHash    String
  effectiveHash String
  createdAt     DateTime @default(now())
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([eventId, createdAt, id])
}

model EventDateEvidence {
  id                      String                 @id @default(cuid())
  eventId                 String
  sourceKind              String
  sourceUrl               String
  sourceRecordId          String
  sourceRegion            String                 @default("NA")
  retrievedAt             DateTime
  contentHash             String
  confirmedStartsAt       DateTime?
  confirmedStartPrecision ScheduleTimePrecision?
  confirmedEndsAt         DateTime?
  confirmedEndPrecision   ScheduleTimePrecision?
  createdAt               DateTime               @default(now())
  event                   Event                  @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([eventId, createdAt, id])
}

model RewardReview {
  id            String           @id @default(cuid())
  rewardId      String
  actorId       String
  sourceHash    String
  effectiveHash String
  createdAt     DateTime         @default(now())
  reward        RewardDefinition @relation(fields: [rewardId], references: [id], onDelete: Restrict)

  @@index([rewardId, createdAt, id])
}

model CuratorChange {
  id         String   @id @default(cuid())
  actorId    String
  targetKind String
  targetId   String
  action     String
  reason     String
  before     Json
  after      Json
  createdAt  DateTime @default(now())

  @@index([targetKind, targetId, createdAt])
  @@index([createdAt])
}

model SyncRun {
  id                    String        @id @default(cuid())
  source                String
  status                SyncRunStatus
  dryRun                Boolean       @default(false)
  startedAt             DateTime      @default(now())
  completedAt           DateTime?
  contentHash           String?
  fetchedCount          Int           @default(0)
  selectedCount         Int           @default(0)
  insertedCount         Int           @default(0)
  updatedCount          Int           @default(0)
  frozenDifferenceCount Int           @default(0)
  rewardCount           Int           @default(0)
  omittedRewardCount    Int           @default(0)
  warningCount          Int           @default(0)
  errorMessage          String?

  @@index([source, startedAt])
  @@index([status, startedAt])
}

model Banner {
  id                String                 @id @default(cuid())
  sourceKey         String                 @unique
  familyId          String?
  name              String
  startsAt          DateTime
  startsAtPrecision ScheduleTimePrecision  @default(EXACT)
  endsAt            DateTime?
  endsAtPrecision   ScheduleTimePrecision?
  status            ScheduleStatus
  sourceUrl         String?
  sourceRegion      String
  family            EventFamily?           @relation(fields: [familyId], references: [id], onDelete: SetNull)
  featured          BannerServant[]
  summonLineups     SummonLineup[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([startsAt])
  @@index([status, startsAt])
  @@index([familyId, startsAt])
}

model Servant {
  id        Int                   @id
  name      String
  className String
  rarity    Int?
  banners   BannerServant[]
  lineups   SummonLineupServant[]
}

model BannerServant {
  bannerId   String
  servantId  Int
  soloRateUp Boolean @default(true)

  banner  Banner  @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  servant Servant @relation(fields: [servantId], references: [id], onDelete: Cascade)

  @@id([bannerId, servantId])
  @@index([servantId])
}

model SummonLineup {
  id             String                @id @default(cuid())
  sourceKey      String                @unique
  bannerId       String
  name           String
  startsAt       DateTime
  endsAt         DateTime?
  evidenceUrl    String
  sourceRegion   String
  lastVerifiedAt DateTime?
  banner         Banner                @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  featured       SummonLineupServant[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([bannerId, startsAt])
  @@index([startsAt, endsAt])
}

model SummonLineupServant {
  lineupId   String
  servantId  Int
  soloRateUp Boolean      @default(true)
  lineup     SummonLineup @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  servant    Servant      @relation(fields: [servantId], references: [id], onDelete: Cascade)

  @@id([lineupId, servantId])
  @@index([servantId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model StoryChapter {
  warId        Int     @id
  name         String
  originalName String
  lastQuestId  Int     @unique
  optional     Boolean
  sortOrder    Int
}
