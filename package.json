{
  "name": "fgo-chronicle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "eslint . && tsc --noEmit",
    "curator:access": "node --env-file=.env scripts/curator-access.mjs",
    "data:import-banners": "node --env-file=.env scripts/import-banner-estimates.mjs",
    "data:import-events": "node --env-file=.env scripts/import-events.mjs",
    "data:prepare-event-review": "node --env-file=.env scripts/prepare-event-review.mjs",
    "data:audit-event-coverage": "node --env-file=.env scripts/audit-event-coverage.mjs",
    "data:sync-event-schedule": "node --env-file=.env scripts/sync-event-schedule.mjs",
    "data:sync-jp-events": "node --env-file=.env scripts/sync-jp-events.mjs",
    "db:generate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed-banners": "node scripts/seed-banner-estimates.mjs",
    "db:import-events": "node --env-file=.env scripts/import-event-data.mjs",
    "db:seed-event-example": "node scripts/import-event-data.mjs data/timeline-events.example.json",
    "dev": "next dev --turbo",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "next build && next start",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@prisma/client": "6.12.0",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tanstack/react-query": "^5.69.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "@vercel/analytics": "^2.0.1",
    "next": "15.5.25",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.4",
    "superjson": "^2.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.0.15",
    "@types/node": "^20.14.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.23.0",
    "eslint-config-next": "15.5.25",
    "postcss": "8.5.28",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "prisma": "6.12.0",
    "tailwindcss": "^4.0.15",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0",
    "vitest": "^4.1.11"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "packageManager": "npm@11.18.0",
  "overrides": {
    "@eslint/eslintrc": {
      "js-yaml": "4.3.2",
      "minimatch": {
        "brace-expansion": "1.1.21"
      }
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": {
        "brace-expansion": "5.0.12"
      }
    },
    "postcss": "8.5.28"
  }
}
